<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>VPNForge configs</title>
  <style>
    body{font-family:monospace;background:#121212;color:#e0e0e0;padding:10px;max-width:900px;margin:0 auto}
    h2{color:#c3e88d;border-top:2px solid #333;padding-top:20px;margin:15px 0 10px;font-size:18px}
    .row{background:#1e1e1e;border:1px solid #333;border-radius:6px;padding:8px;display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}
    .label{background:#2c2c2c;color:#82aaff;padding:6px 10px;border-radius:4px;font-weight:700;font-size:13px;min-width:180px;text-align:center}
    .code{flex:1;white-space:nowrap;overflow-x:auto;padding:8px;background:#121212;border-radius:4px;color:#c3e88d;font-size:12px}
    button,a.btn{background:#333;color:#e0e0e0;border:1px solid #555;padding:7px 12px;border-radius:4px;cursor:pointer;font-weight:700;text-decoration:none}
    button:hover,a.btn:hover{background:#c3e88d;color:#121212;border-color:#c3e88d}@media(max-width:600px){.label,.code{width:100%;min-width:100%}button,a.btn{flex:1}}
  </style>
</head>
<body>
  <h2>TXT subscription</h2>
  <div class="row">
    <div class="label">Subscription</div>
    <div class="code" id="subscription">{{ subscription_url|e }}</div>
    <button type="button" data-copy="subscription">Copy</button>
    <a class="btn" href="happ://add/{{ subscription_url|e }}">Add to HAPP</a>
  </div>
{% if settings.enable_hysteria %}
  <h2>Hysteria 2</h2>
  <div class="row">
    <div class="label">Client YAML</div>
    <div class="code" id="hysteria-yaml">{{ hysteria_client_url|e }}</div>
    <button type="button" data-copy="hysteria-yaml">Copy</button>
    <a class="btn" href="{{ hysteria_client_url|e }}">Download</a>
  </div>
{% endif %}
  <h2>Configs</h2>
{% for item in client_links %}
  <div class="row">
    <div class="label">{{ item.title|e }}</div>
    <div class="code" id="config-{{ loop.index }}">{{ item.link|e }}</div>
    <button type="button" data-copy="config-{{ loop.index }}">Copy</button>
  </div>
{% endfor %}
  <script>
    document.addEventListener("click", async event => {
      const button = event.target.closest("button[data-copy]");
      if (!button) return;
      await navigator.clipboard.writeText(document.getElementById(button.dataset.copy).textContent);
      button.textContent = "OK";
      setTimeout(() => { button.textContent = "Copy"; }, 1200);
    });
  </script>
</body>
</html>
