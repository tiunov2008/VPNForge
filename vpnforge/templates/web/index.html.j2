<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="index,follow">
  <title>Sleep Market</title>
  <style>
    :root{--bg:#f7f3ed;--card:#fff;--text:#1f2933;--muted:#667085;--accent:#2f6f5e;--line:#e6ded2}
    *{box-sizing:border-box}body{margin:0;font:16px/1.55 Arial,sans-serif;color:var(--text);background:var(--bg)}
    .wrap{width:min(1080px,calc(100% - 32px));margin:auto}.hero{padding:90px 0;background:linear-gradient(135deg,#fffaf3,#e8f3ee);border-bottom:1px solid var(--line)}
    h1{font-size:clamp(38px,6vw,68px);line-height:1.05;margin:0 0 20px;max-width:780px}.lead{max-width:680px;color:var(--muted);font-size:19px}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding:64px 0}.card{background:var(--card);padding:26px;border:1px solid var(--line);border-radius:20px}
    .card h2{margin-top:0}.card p,footer{color:var(--muted)}footer{padding:30px 0;border-top:1px solid var(--line)}@media(max-width:700px){.grid{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <header class="hero"><div class="wrap"><h1>Comfort for better sleep</h1><p class="lead">Mattresses, pillows and bedroom accessories selected for reliable everyday comfort.</p></div></header>
  <main class="wrap grid">
    <article class="card"><h2>Support</h2><p>Balanced options for different sleeping positions and comfort preferences.</p></article>
    <article class="card"><h2>Materials</h2><p>Practical, durable materials suitable for homes and guest rooms.</p></article>
    <article class="card"><h2>Delivery</h2><p>Clear delivery terms and help choosing the correct dimensions.</p></article>
  </main>
  <footer><div class="wrap">Sleep Market information page</div></footer>
</body>
</html>
