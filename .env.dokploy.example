# Paste these into the Dokploy Compose service's Environment tab.
# Dokploy writes them to a .env next to the compose file; the compose file
# forwards each one explicitly, because Dokploy does not inject .env into
# containers by itself.

# --- required ---------------------------------------------------------------

# Must already resolve to this server: Traefik obtains the certificate over an
# HTTP-01 challenge, and the cert sidecar copies it out for Xray and Hysteria.
DOMAIN=vpn.example.com

# --- Hysteria 2 -------------------------------------------------------------

# Compose decides whether the Hysteria container runs at all. Leave this empty
# to deploy without Hysteria. It must agree with ENABLE_HYSTERIA below or the
# init container refuses to start.
COMPOSE_PROFILES=hysteria
ENABLE_HYSTERIA=true

# Port-hopping range, UDP. Keep the upper bound below 32768: the Linux default
# ephemeral range starts there and overlapping it disturbs the host's own
# outbound connections. Open this range in the provider firewall and UFW.
HYSTERIA_PORT_RANGE=20000-32000

# --- Xray -------------------------------------------------------------------

# Host ports. 443 belongs to Dokploy's Traefik, so REALITY runs elsewhere.
# Anything free works; 2053, 2083, 2087 and 2096 are conventional.
XRAY_REALITY_PORT=2053
XRAY_TLS_PORT=8443

ENABLE_XRAY=true
FINGERPRINT=firefox

# --- optional ---------------------------------------------------------------

# Defaults to admin@$DOMAIN. Only used to fill the settings file; Traefik's own
# ACME account e-mail is configured in Dokploy, not here.
# EMAIL=admin@vpn.example.com

# Name clients show for the subscription.
# SUBSCRIPTION_TITLE=VPNForge

# Where Dokploy keeps Traefik's dynamic config, including acme.json. Only
# change this if you installed Dokploy somewhere other than /etc/dokploy.
# DOKPLOY_TRAEFIK_DYNAMIC=/etc/dokploy/traefik/dynamic

# How often the sidecar re-reads acme.json, and how often nginx reloads to pick
# up a renewed certificate. Seconds.
# CERT_POLL_INTERVAL=60
# NGINX_RELOAD_INTERVAL=900
